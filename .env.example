# Application Environment Configuration
# Copy this file to .env and adjust values for your environment

APP_NAME="Apex HRMS"
APP_ENV=development
APP_DEBUG=true
APP_URL="http://localhost/HRM%20SYSTEM/public"
APP_TIMEZONE="UTC"
APP_SECRET="change-this-to-a-random-32-character-secret-key"

# Database Configuration (XAMPP Default: root with no password)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrm_system
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session Security Configuration
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Real Email Delivery Configuration (SMTP - e.g. Gmail / Outlook / Custom)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="HRMate Portal"
